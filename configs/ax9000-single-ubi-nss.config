CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax9000_single_ubi=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_JSON_CYCLONEDX_SBOM=y
CONFIG_KERNEL_BUILD_USER="nexawrt"
CONFIG_KERNEL_BUILD_DOMAIN="builder"
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_CODE="nexawrt-r0-d6848fa2"
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump-mini=y

# Experimental NSS acceleration flavor. Keep the first NSS image deliberately
# small: core driver/ECM plus IPQ807x firmware 12.5, without mesh or SQM.
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_12_2 is not set
# CONFIG_NSS_FIRMWARE_VERSION_12_1 is not set
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
# CONFIG_ATH11K_NSS_SUPPORT is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# CONFIG_PACKAGE_sqm-scripts-nss is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_luci-app-sqm is not set

# Preserve the RAM-only safety model; include only patched read-only U-Boot readers.
# CONFIG_PACKAGE_mtd is not set
CONFIG_PACKAGE_uboot-envtools=y
# CONFIG_PACKAGE_ubi-utils is not set

CONFIG_DEVEL=y
CONFIG_EXPERIMENTAL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
