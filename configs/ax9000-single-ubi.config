CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax9000_single_ubi=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_JSON_CYCLONEDX_SBOM=y
CONFIG_KERNEL_BUILD_USER="nexawrt"
CONFIG_KERNEL_BUILD_DOMAIN="builder"
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_CODE="nexawrt-r0-f0a60eee"
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump-mini=y

# Keep the first release candidate close to official OpenWrt.
# Third-party NSS acceleration/ECM/firmware, proxy suites, containers, storage servers and third-party feeds
# are intentionally excluded until the base image passes hardware testing.

# Build the NexaWrt repository helper as an APK artifact without installing it in the RAM-test image.
CONFIG_PACKAGE_nexawrt-repository=m
