 endef
-TARGET_DEVICES += xiaomi_ax9000
+# Deliberately do not expose the stock xiaomi_ax9000 profile: the DTS in this
+# project describes single-large-UBI-v1 and must never produce a stock-looking
+# factory image. Keep a distinct RAM-test profile and output filename instead.
+define Device/xiaomi_ax9000_single_ubi
+	$(call Device/xiaomi_ax9000)
+	DEVICE_DTS := ipq8072-ax9000
+	DEVICE_VARIANT := single-large-UBI-v1-ram-test
+	SUPPORTED_DEVICES := xiaomi,ax9000
+	DEVICE_COMPAT_VERSION := 2.0
+	DEVICE_COMPAT_MESSAGE := NexaWrt AX9000 RAM-test profile; persistent upgrade is unsupported
+	DEVICE_PACKAGES += -uboot-envtools -ubi-utils -mtd
+	IMAGES :=
+	ARTIFACTS :=
+endef
+TARGET_DEVICES += xiaomi_ax9000_single_ubi
 
